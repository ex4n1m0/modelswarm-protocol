# Normalize to LF in the repository; check out native on Windows.
* text=auto

# Always LF (executed/parsed cross-platform)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.proto text eol=lf
*.lock text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.gguf binary
*.png binary
*.exe binary
