# ships raw code only (owner directive 2026-10-05). Checksums stay tracked.
apps/tracker/public/downloads/*.exe
apps/tracker/public/downloads/*.deb
apps/tracker/public/downloads/*.AppImage
apps/tracker/public/downloads/*.dmg

