{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelswarm.deepflux.space/schemas/experiments/run-manifest-v1.json",
  "title": "ModelSwarm benchmark run manifest (frozen Phase A, ADR-013)",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "run_manifest_id", "created_at", "harness_version", "profile_id", "runtime", "network_cell", "seeds"],
  "properties": {
    "record_type": { "const": "run-manifest/v1" },
    "run_manifest_id": { "type": "string", "pattern": "^run-[0-9a-f]{16}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "harness_version": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "pattern": "^msp1:[0-9a-f]{64}$" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build_hash"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "build_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "hardware_class_peers": {
      "type": "array",
      "items": { "enum": ["cpu", "gpu_entry", "gpu_mid", "gpu_high"] }
    },
    "os": { "type": "string" },
    "generation_params_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "network_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nominal_rtt_ms", "jitter", "loss_ratio", "path"],
      "properties": {
        "nominal_rtt_ms": { "enum": [0, 5, 10, 20, 40, 80, 150] },
        "jitter": { "enum": ["none", "low", "high"] },
        "loss_ratio": { "enum": [0, 0.001, 0.01, 0.03] },
        "path": { "enum": ["direct", "relayed"] },
        "measured_rtt_ms_p50": { "type": "number", "minimum": 0 },
        "calibration_valid": { "type": "boolean" }
      }
    },
    "prompt_corpus_id": { "type": "string", "minLength": 1 },
    "warmup_runs": { "type": "integer", "minimum": 0 },
    "recorded_runs": { "type": "integer", "minimum": 1 },
    "seeds": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
    "confidence_margin": { "type": "number", "minimum": 0.05 }
  }
}
