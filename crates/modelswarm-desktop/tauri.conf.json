{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelSwarm",
  "identifier": "space.deepflux.modelswarm",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ModelSwarm — INTERNAL TEST (UNSIGNED)",
        "label": "main",
        "width": 1152,
        "height": 648,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RkM5OENCNEIwNjRGMzcKUldRM1R3Wkx5NWo4T0NpWHY2L2U3QzVUMVluTHQyRnErdmVCeFM5ZmF2VUUyT2JudXk0bzdQTmEK",
      "endpoints": [
        "https://modelswarm.deepflux.space/downloads/latest.json?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "engine/*",
      "engine-vulkan/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
